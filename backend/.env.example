# Copy to .env for local dev overrides. The app works without this file —
# defaults use SQLite for both DBs so no Postgres is needed locally.

ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
SECRET_KEY=dev-insecure-secret-change-in-production

# Dev default (SQLite — no Postgres needed):
# USER_DB_URL=sqlite+aiosqlite:///./data/user.db

# Switch to Postgres if you want (or set this in Railway env vars for prod):
# USER_DB_URL=postgresql+psycopg://mist:mist@localhost:5432/mist
